{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "declaration": false,
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "@pages/*": [
                "src/pages/*"
            ],
            "@modules/*": [
                "src/modules/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ],
            "@api/*": [
                "src/api/*"
            ],
            "@fixtures": [
                "src/fixtures/index"
            ],
            "@config/*": [
                "src/config/*"
            ],
            "@testdata/*": [
                "src/test-data/*"
            ]
        },
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "playwright.config.ts"
    ],
    "exclude": [
        "node_modules",
        "test-results",
        "playwright-report",
        "tta-report",
        "dist"
    ]
}